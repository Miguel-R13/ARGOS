# ============================================================
# ARGOS-NET-001 | RECON | TCP SYN Port Scan - Nmap Invariant
# ============================================================
# MITRE: T1046 - Network Service Discovery | TA0043 - Reconnaissance
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-23
# Descripcion: Detecta escaneos SYN masivos con window size 1024,
# invariante del motor de nmap. Umbral: 20 SYN en 3 segundos
# desde la misma IP origen hacia la SOC LAN.
# ============================================================
alert tcp any any -> $HOME_NET any (msg:"ARGOS RECON TCP SYN Port Scan - Nmap Invariant win1024"; flags:S,12; window:1024; threshold:type threshold,track by_src,count 20,seconds 3; classtype:network-scan; sid:9000001; rev:1; metadata:created_at 2026_08_23, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1046, mitre_technique_name Network_Service_Discovery;)

# ============================================================
# ARGOS-NET-01b | RECON | TCP SYN Port Scan - Generic Scanner
# ============================================================
# MITRE: T1046 - Network Service Discovery | TA0043 - Reconnaissance
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-23
# Descripcion: Detecta escaneos de puertos genericos por comportamiento.
# Umbral: 50 paquetes SYN desde la misma IP en 5 segundos.
# Cubre masscan, zmap y cualquier escaner independiente del window size.
# ============================================================
alert tcp any any -> $HOME_NET any (msg:"ARGOS RECON TCP SYN Port Scan - Generic Scanner Threshold"; flags:S,12; threshold:type threshold,track by_src,count 50,seconds 5; classtype:network-scan; sid:9000002; rev:1; metadata:created_at 2026_08_23, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1046, mitre_technique_name Network_Service_Discovery;)


# ============================================================
# ARGOS-NET-02 | INITIAL ACCESS | SSH Brute Force Non-Standard Banner
# ============================================================
# MITRE: T1110.001 - Brute Force: Password Guessing | TA0001 - Initial Access
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta clientes SSH con banner no perteneciente a la
# whitelist de clientes legitimos del entorno ARGOS (OpenSSH).
# Cubre hydra (libssh_0.x), medusa (MEDUSA_1.0), ncrack y cualquier
# herramienta de brute force con banner no estandar.
# Whitelist empirica: SSH-2.0-OpenSSH (unico cliente legitimo en SOC LAN)

# ============================================================
alert ssh any any -> $HOME_NET 22 (msg:"ARGOS INITIAL ACCESS SSH Brute Force Non-Standard Client Banner"; flow:established,to_server; ssh.software; content:!"OpenSSH"; classtype:attempted-admin; sid:9000003; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1110.001, mitre_technique_name Brute_Force_Password_Guessing;)

# ============================================================
# ARGOS-NET-03 | C2 | Reverse Shell TCP hacia zona atacantes interna
# ============================================================
# MITRE: T1059.004 - Unix Shell | TA0011 - Command and Control
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta conexion TCP desde endpoints hacia zona .40.
# Cualquier conexion .20/.30 -> .40 es sospechosa por definicion
# en el laboratorio ARGOS.
# ============================================================
alert tcp 192.168.234.20,192.168.234.30 any -> 192.168.234.40 any (msg:"ARGOS C2 Reverse Shell TCP hacia zona atacantes interna"; flow:established,to_server; classtype:command-and-control; sid:9000004; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)

# ============================================================
# ARGOS-NET-03b | C2 | Reverse Shell TCP hacia IP externa puerto no estandar
# ============================================================
# MITRE: T1059.004 - Unix Shell | TA0011 - Command and Control
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta conexion TCP establecida desde endpoints internos
# hacia cualquier IP externa en puertos no estandar (excluye puertos
# de servicios legitimos: 22, 80, 443, 1514, 1515, 55000).
# Cubre reverse shells hacia C2 en internet.
# ============================================================
alert tcp 192.168.234.20,192.168.234.30 any -> !192.168.234.0/24 ![$HTTP_PORTS,22,443,1514,1515,55000] (msg:"ARGOS C2 Reverse Shell TCP hacia IP externa puerto no estandar"; flow:established,to_server; classtype:command-and-control; sid:9000005; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)

# ============================================================
# ARGOS-NET-04 | C2 | HTTP Beaconing User-Agent anomalo en SOC LAN
# ============================================================
# MITRE: T1071.001 - Web Protocols | TA0011 - Command and Control
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta cualquier trafico HTTP en la SOC LAN 192.168.234.0/24.
# En este entorno no existe trafico HTTP legitimo entre zonas en ens33.
# Cualquier HTTP en ens33 es indicador de C2 o beaconing.
# ============================================================
alert http $HOME_NET any -> $HOME_NET any (msg:"ARGOS C2 HTTP Beaconing en SOC LAN, trafico HTTP anomalo entre zonas"; flow:established,to_server; classtype:command-and-control; sid:9000006; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# ============================================================
# ARGOS-NET-05 | C2 | DNS Tunneling subdominio largo
# ============================================================
# MITRE: T1071.004 - DNS | TA0011 - Command and Control
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta DNS tunneling por longitud anomala del subdominio.
# Subdominios de mas de 30 caracteres son invariante de tunneling.
# Cubre dnscat2, iodine y cualquier herramienta que codifique datos en DNS.
# ============================================================
alert dns $HOME_NET any -> any 53 (msg:"ARGOS C2 DNS Tunneling subdominio largo mayor 30 caracteres"; dns.query; pcre:"/^[^.]{30,}\./i"; classtype:command-and-control; sid:9000007; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)

# ============================================================
# ARGOS-NET-06 | C2 | ICMP Tunneling payload anomalo
# ============================================================
# MITRE: T1095 - Non-Application Layer Protocol | TA0011 - Command and Control
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta ICMP tunneling por payload anormalmente grande.
# Ping legitimo usa 56-64 bytes. Payload mayor de 100 bytes indica
# datos embebidos. Cubre icmpsh, ptunnel y herramientas similares.
# ============================================================
alert icmp $HOME_NET any -> any any (msg:"ARGOS C2 ICMP Tunneling payload anomalo mayor 100 bytes"; itype:8; dsize:>100; classtype:command-and-control; sid:9000008; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1095, mitre_technique_name Non_Application_Layer_Protocol;)

# ============================================================
# ARGOS-NET-07 | C2 | Long Connection TCP beaconing persistente
# ============================================================
# MITRE: T1571 - Non-Standard Port | TA0011 - Command and Control
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta beaconing persistente: multiples paquetes TCP
# desde el mismo origen hacia zona atacantes en ventana de 60 segundos.
# Invariante de RAT activo manteniendo canal C2 abierto.
# ============================================================
alert tcp 192.168.234.20,192.168.234.30 any -> 192.168.234.40 any (msg:"ARGOS C2 Long Connection TCP beaconing persistente hacia zona atacantes"; flow:established,to_server; detection_filter:track by_src,count 5,seconds 60; classtype:command-and-control; sid:9000009; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1571, mitre_technique_name Non_Standard_Port;)

# ============================================================
# ARGOS-NET-08 | LATERAL MOVEMENT | SSH hacia multiples destinos internos
# ============================================================
# MITRE: T1021.004 - Remote Services SSH | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta endpoint comprometido realizando SSH hacia multiples
# destinos internos. Threshold: 3 conexiones TCP:22 en 60 segundos
# desde el mismo origen. Ningún usuario legitimo hace SSH masivo interno.
# ============================================================
alert tcp $HOME_NET any -> $HOME_NET 22 (msg:"ARGOS LATERAL MOVEMENT SSH hacia multiples destinos internos"; flow:to_server; threshold:type threshold,track by_src,count 3,seconds 60; classtype:attempted-admin; sid:9000010; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1021.004, mitre_technique_name Remote_Services_SSH;)

# ============================================================
# ARGOS-NET-09 | LATERAL MOVEMENT | RDP hacia multiples destinos
# ============================================================
# MITRE: T1021.001 - Remote Desktop Protocol | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta movimiento lateral RDP: un origen conectando
# a multiples destinos internos en puerto 3389. Track by_src.
# Threshold: 5 conexiones en 60 segundos desde el mismo origen.
# ============================================================
alert tcp any any -> $HOME_NET 3389 (msg:"ARGOS LATERAL MOVEMENT RDP hacia multiples destinos internos"; flow:to_server; threshold:type threshold,track by_src,count 5,seconds 60; classtype:attempted-admin; sid:9000011; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1021.001, mitre_technique_name Remote_Desktop_Protocol;)

# ============================================================
# ARGOS-NET-09b | LATERAL MOVEMENT | RDP Brute Force mismo destino
# ============================================================
# MITRE: T1110.001 - Brute Force Password Guessing | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta brute force RDP clasico: multiples intentos
# contra el mismo destino en puerto 3389. Track by_dst.
# Threshold: 10 conexiones en 60 segundos hacia el mismo destino.
# ============================================================
alert tcp any any -> $HOME_NET 3389 (msg:"ARGOS LATERAL MOVEMENT RDP Brute Force multiples intentos mismo destino"; flow:to_server; threshold:type threshold,track by_dst,count 10,seconds 60; classtype:attempted-admin; sid:9000012; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1110.001, mitre_technique_name Brute_Force_Password_Guessing;)

# ============================================================
# ARGOS-NET-10 | LATERAL MOVEMENT | SMB anomalo entre endpoints
# ============================================================
# MITRE: T1021.002 - SMB Windows Admin Shares | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-24
# Descripcion: Detecta trafico SMB anomalo en la SOC LAN.
# Los endpoints no comparten recursos SMB entre si en condiciones normales.
# Cubre PsExec, Impacket, CrackMapExec y EternalBlue.
# Threshold: 3 conexiones TCP:445 en 60 segundos desde el mismo origen.
# ============================================================
alert tcp any any -> $HOME_NET 445 (msg:"ARGOS LATERAL MOVEMENT SMB anomalo multiples conexiones puerto 445"; flow:to_server; threshold:type threshold,track by_src,count 3,seconds 60; classtype:attempted-admin; sid:9000013; rev:1; metadata:created_at 2026_08_24, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1021.002, mitre_technique_name SMB_Windows_Admin_Shares;)

# ============================================================
# ARGOS-NET-11 | LATERAL MOVEMENT | WMI RPC endpoint mapper
# ============================================================
# MITRE: T1047 - Windows Management Instrumentation | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-25
# Descripcion: Detecta multiples conexiones al puerto 135 RPC desde
# el mismo origen. Invariante de WMI lateral movement: el atacante
# contacta el endpoint mapper antes de ejecutar comandos remotos via WMI.
# Threshold: 3 conexiones TCP:135 en 60 segundos desde el mismo origen.
# ============================================================
alert tcp any any -> $HOME_NET 135 (msg:"ARGOS LATERAL MOVEMENT WMI RPC multiples conexiones puerto 135"; flow:to_server; threshold:type threshold,track by_src,count 3,seconds 60; classtype:attempted-admin; sid:9000014; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1047, mitre_technique_name Windows_Management_Instrumentation;)

# ============================================================
# ARGOS-NET-12 | LATERAL MOVEMENT | Pass-the-Hash NTLM SMB
# ============================================================
# MITRE: T1550.002 - Pass the Hash | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-25
# Descripcion: Detecta autenticacion NTLM en trafico SMB mediante
# inspeccion del magic bytes NTLMSSP en el payload.
# La presencia de NTLMSSP en SMB desde endpoints hacia destinos internos
# donde no deberia haber autenticacion es invariante de Pass-the-Hash.
# ============================================================
alert tcp $HOME_NET any -> $HOME_NET 445 (msg:"ARGOS LATERAL MOVEMENT Pass-the-Hash NTLM autenticacion SMB anomala"; flow:established,to_server; content:"NTLMSSP"; classtype:attempted-admin; sid:9000015; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1550.002, mitre_technique_name Pass_the_Hash;)

# ============================================================
# ARGOS-NET-13 | LATERAL MOVEMENT | Port Scan interno desde endpoint comprometido
# ============================================================
# MITRE: T1046 - Network Service Discovery | TA0008 - Lateral Movement
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-25
# Descripcion: Detecta escaneo de puertos interno desde endpoints
# comprometidos (.20/.30) hacia otros hosts de la SOC LAN.
# Complementa ESC01/ESC01b que detectan escaneos desde zona atacantes.
# Cuando el origen es un endpoint interno el nivel de severidad es mayor
# porque indica que la red ya fue penetrada y el atacante se mueve lateralmente.
# ============================================================
alert tcp 192.168.234.20,192.168.234.30 any -> $HOME_NET any (msg:"ARGOS LATERAL MOVEMENT Port Scan interno desde endpoint comprometido"; flags:S,12; threshold:type threshold,track by_src,count 20,seconds 3; classtype:network-scan; sid:9000016; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1046, mitre_technique_name Network_Service_Discovery;)

# ============================================================
# ARGOS-NET-14 | EXFILTRATION | Transferencia masiva de datos TCP hacia exterior
# ============================================================
# MITRE: T1048 - Exfiltration Over Alternative Protocol | TA0010 - Exfiltration
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-25
# Descripcion: Detecta exfiltracion por volumen: transferencia TCP masiva
# desde endpoints hacia IPs externas a la SOC LAN.
# Excluye trafico hacia HOME_NET para evitar solape con ESC03/ESC07.
# Excluye puertos legitimos: 22, 80, 443, 1514.
# detection_filter: 1000 paquetes en 60s para reducir ruido.
# ============================================================
alert tcp 192.168.234.20,192.168.234.30 any -> !192.168.234.0/24 ![22,80,443,1514] (msg:"ARGOS EXFILTRATION Flujo TCP masivo desde endpoint hacia IP externa"; flow:established,to_server; dsize:>1000; detection_filter:track by_src,count 1000,seconds 60; classtype:policy-violation; sid:9000017; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0010, mitre_tactic_name Exfiltration, mitre_technique_id T1048, mitre_technique_name Exfiltration_Over_Alternative_Protocol;)

# ============================================================
# ARGOS-NET-15 | EXFILTRATION | FTP saliente desde endpoint
# ============================================================
# MITRE: T1048.003 - Exfiltration Over Unencrypted Protocol | TA0010 - Exfiltration
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-25
# Descripcion: Detecta cualquier trafico FTP en la red.
# FTP es un protocolo obsoleto e inseguro que no deberia existir
# en ningun entorno corporativo moderno. Cualquier conexion al
# puerto 21 desde cualquier origen es sospechosa por definicion.
# ============================================================
alert tcp any any -> any 21 (msg:"ARGOS EXFILTRATION FTP detectado en la red, protocolo inseguro de transferencia de ficheros"; flow:to_server; threshold:type limit,track by_src,count 1,seconds 60; classtype:policy-violation; sid:9000018; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0010, mitre_tactic_name Exfiltration, mitre_technique_id T1048.003, mitre_technique_name Exfiltration_Over_Unencrypted_Protocol;)

# ============================================================
# ARGOS-NET-16 | EXFILTRATION | SMB hacia exterior
# ============================================================
# MITRE: T1048 - Exfiltration Over Alternative Protocol | TA0010 - Exfiltration
# Author: ARGOS SOC - Miguel Reguero | Created: 2026-08-25
# Descripcion: Detecta conexiones SMB desde endpoints hacia IPs externas
# a la SOC LAN. SMB no deberia salir de la red interna bajo ninguna
# circunstancia. Tecnica documentada en APTs como Lazarus y APT29.
# Threshold: 3 conexiones en 60 segundos desde el mismo origen.
# ============================================================
alert tcp 192.168.234.20,192.168.234.30 any -> !192.168.234.0/24 445 (msg:"ARGOS EXFILTRATION SMB hacia exterior, posible exfiltracion via recurso compartido externo"; flow:to_server; threshold:type threshold,track by_src,count 3,seconds 60; classtype:policy-violation; sid:9000019; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0010, mitre_tactic_name Exfiltration, mitre_technique_id T1048, mitre_technique_name Exfiltration_Over_Alternative_Protocol;)

# ============================================================
# ============================================================
# ARGOS IPS - MODO ACTIVO: REGLAS DROP SELECTIVO
# ============================================================
# Las siguientes reglas bloquean activamente el trafico en lugar
# de solo alertar (IDS). Solo se aplica drop a vectores con
# certeza absoluta y minimo riesgo de falso positivo en ARGOS.
# Criterio SOC: si el vector no tiene uso legitimo posible -> drop.
# Vectores en drop: ESC02, ESC03, ESC04, ESC05, ESC06, ESC12, ESC15, ESC16
# Vectores solo alert: ESC01, ESC07, ESC08, ESC09, ESC10, ESC11, ESC13, ESC14
# ============================================================
# ============================================================

# DROP ESC02: SSH Brute Force banner no estandar
# Certeza alta: cliente SSH no OpenSSH intentando autenticacion masiva
drop tcp any any -> $HOME_NET 22 (msg:"ARGOS IPS DROP ESC02 SSH Brute Force banner no estandar bloqueado"; flow:established,to_server; content:"SSH-"; depth:4; pcre:"/^SSH-[\d.]+-(?!OpenSSH)/"; threshold:type threshold,track by_src,count 5,seconds 60; classtype:attempted-admin; sid:9000025; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, mitre_technique_id T1110.001, mitre_technique_name Brute_Force_Password_Guessing;)

# DROP ESC03: Reverse Shell TCP hacia zona atacantes interna
# Certeza absoluta: ningun trafico legitimo va de .20/.30 hacia .40
drop tcp 192.168.234.20,192.168.234.30 any -> 192.168.234.40 any (msg:"ARGOS IPS DROP ESC03 Reverse Shell TCP hacia zona atacantes bloqueado"; flow:established,to_server; classtype:command-and-control; sid:9000026; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)

# DROP ESC04: HTTP Beaconing en SOC LAN
# Certeza absoluta: HTTP no deberia existir en ens33 bajo ninguna circunstancia
drop http $HOME_NET any -> $HOME_NET any (msg:"ARGOS IPS DROP ESC04 HTTP Beaconing en SOC LAN bloqueado"; flow:established,to_server; classtype:command-and-control; sid:9000027; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# DROP ESC05: DNS Tunneling subdominio largo
# Certeza absoluta: subdominios de mas de 30 caracteres sin uso legitimo
drop dns $HOME_NET any -> any 53 (msg:"ARGOS IPS DROP ESC05 DNS Tunneling subdominio largo bloqueado"; dns.query; pcre:"/^[^.]{30,}\./i"; classtype:command-and-control; sid:9000022; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)

# DROP ESC06: ICMP Tunneling payload anomalo
# Certeza absoluta: payload ICMP mayor 100 bytes sin uso legitimo en ARGOS
drop icmp any any -> any any (msg:"ARGOS IPS DROP ESC06 ICMP Tunneling payload anomalo bloqueado"; itype:8; dsize:>100; classtype:command-and-control; sid:9000023; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0011, mitre_tactic_name Command_And_Control, mitre_technique_id T1095, mitre_technique_name Non_Application_Layer_Protocol;)

# DROP ESC12: Pass-the-Hash NTLMSSP en SMB
# Certeza alta: autenticacion NTLM en SMB desde endpoints anomala en ARGOS
drop tcp $HOME_NET any -> $HOME_NET 445 (msg:"ARGOS IPS DROP ESC12 Pass-the-Hash NTLM SMB bloqueado"; flow:established,to_server; content:"NTLMSSP"; classtype:attempted-admin; sid:9000024; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1550.002, mitre_technique_name Pass_the_Hash;)

# DROP ESC15: FTP en la red
# Certeza absoluta: FTP no deberia existir en ningun entorno moderno
drop tcp any any -> any 21 (msg:"ARGOS IPS DROP ESC15 FTP bloqueado, protocolo inseguro prohibido"; flow:to_server; threshold:type limit,track by_src,count 1,seconds 60; classtype:policy-violation; sid:9000020; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0010, mitre_tactic_name Exfiltration, mitre_technique_id T1048.003, mitre_technique_name Exfiltration_Over_Unencrypted_Protocol;)

# DROP ESC16: SMB hacia exterior
# Certeza absoluta: SMB no debe salir de la red interna bajo ninguna circunstancia
drop tcp 192.168.234.20,192.168.234.30 any -> !192.168.234.0/24 445 (msg:"ARGOS IPS DROP ESC16 SMB hacia exterior bloqueado"; flow:to_server; threshold:type limit,track by_src,count 1,seconds 60; classtype:policy-violation; sid:9000021; rev:1; metadata:created_at 2026_08_25, author "ARGOS SOC - Miguel Reguero", mitre_tactic_id TA0010, mitre_tactic_name Exfiltration, mitre_technique_id T1048, mitre_technique_name Exfiltration_Over_Alternative_Protocol;)
