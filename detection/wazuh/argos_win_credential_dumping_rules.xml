<group name="argos,credential_access,">

  <!-- ARGOS Rule 102100: LSASS memory access for credential dumping -->
  <!-- Universal coverage: mimikatz, procdump, comsvcs.dll MiniDump, Task Manager -->
  <!-- Any tool accessing LSASS memory generates Sysmon EID 10 -->
  <!-- GrantedAccess values typical for credential dumping: -->
  <!--   0x1410: mimikatz sekurlsa::logonpasswords -->
  <!--   0x1010: procdump / Task Manager dump -->
  <!--   0x143a: mimikatz with debug privilege -->
  <!--   0x1fffff: full process access -->
  <!-- Requires lsass.exe in Sysmon ProcessAccess include rules -->
  <!-- if_group sysmon_event_10: Sysmon EID 10 processing chain -->
  <!-- Wazuh has NO native rule for LSASS access - full ARGOS coverage -->
  <rule id="102100" level="15">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.grantedAccess" type="pcre2">0x1410|0x1010|0x143a|0x1438|0x1fffff</field>
    <description>ARGOS: LSASS memory access detected - credential dumping attempt by $(win.eventdata.sourceImage) with access $(win.eventdata.grantedAccess)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>argos,credential_access,lsass_dump</group>
  </rule>

<!-- ARGOS Rule 102101: Any LSASS access regardless of GrantedAccess -->
  <!-- Broader coverage: catches tools with unusual GrantedAccess values -->
  <!-- Level 12 because not all LSASS access is malicious -->
  <!-- Exclusions: svchost, EdgeUpdate - legitimate system processes -->
  <rule id="102101" level="12">
    <if_group>sysmon_event_10</if_group>
    <field name="win.eventdata.targetImage" type="pcre2">(?i)lsass\.exe$</field>
    <field name="win.eventdata.sourceImage" negate="yes" type="pcre2">(?i)(svchost\.exe|MicrosoftEdgeUpdate\.exe|EdgeUpdate\.exe|wazuh-agent\.exe|MsMpEng\.exe)$</field>
    <description>ARGOS: Process accessing LSASS memory - $(win.eventdata.sourceImage) with GrantedAccess $(win.eventdata.grantedAccess)</description>
    <mitre><id>T1003.001</id></mitre>
    <group>argos,credential_access,lsass_access</group>
  </rule>


</group>
