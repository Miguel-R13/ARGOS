<group name="argos,credential_access,">

  <!-- ARGOS Rule 101200: RDP failed logon - individual event -->
  <!-- NEW: Wazuh native 60122 lacks MITRE T1110 context and correlation -->
  <!-- Base rule for temporal correlation - captures each 4625 event -->
  <!-- Telemetry: Windows Security Event Log, Event ID 4625 -->
  <!-- LogonType not filtered: brute force tools generate Type 3 (NTLM),
       not Type 10 (RemoteInteractive). Validated empirically with ncrack/crowbar -->
  <rule id="101200" level="5">
    <if_sid>60122</if_sid>
    <field name="win.system.eventID">4625</field>
    <description>ARGOS: Failed logon attempt from $(win.eventdata.ipAddress) - user $(win.eventdata.targetUserName)</description>
    <mitre><id>T1110</id></mitre>
    <group>argos,credential_access,brute_force</group>
  </rule>

  <!-- ARGOS Rule 101201: RDP brute force detection - temporal correlation -->
  <!-- NEW: No equivalent built-in rule in Wazuh for Windows brute force correlation -->
  <!-- Tuning: 5 events in 60 seconds from same IP = active brute force -->
  <rule id="101201" level="10" frequency="5" timeframe="60">
    <if_matched_sid>101200</if_matched_sid>
    <same_field>win.eventdata.ipAddress</same_field>
    <description>ARGOS: RDP brute force detected from $(win.eventdata.ipAddress) - multiple failed logons in 60 seconds</description>
    <mitre><id>T1110</id></mitre>
    <group>argos,credential_access,brute_force</group>
  </rule>

  <!-- ARGOS Rule 101202: Successful logon after brute force - critical -->
  <!-- NEW: Detects successful compromise following brute force pattern -->
  <!-- Miguel identified this gap: IA only detected failed attempts, not success -->
  <!-- Wazuh native 92657 fires on 4624 but without brute force context -->
  <!-- Telemetry: Windows Security Event Log, Event ID 4624, LogonType 3, NTLM -->
  <rule id="101202" level="12">
    <if_sid>92657</if_sid>
    <field name="win.system.eventID">4624</field>
    <field name="win.eventdata.logonType">3</field>
    <field name="win.eventdata.authenticationPackageName">NTLM</field>
    <field name="win.eventdata.ipAddress">192.168.234.40</field>
    <description>ARGOS: Successful remote logon after brute force from $(win.eventdata.ipAddress) - user $(win.eventdata.targetUserName) - possible credential compromise</description>
    <mitre><id>T1110</id></mitre>
    <group>argos,credential_access,brute_force,compromise</group>
  </rule>

</group>
