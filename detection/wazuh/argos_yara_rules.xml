    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>argos_yara,credential_access</group>
  </rule>

  <!-- YARA-15: LSASS minidump (ESC21/ESC22 - T1003.001) -->
  <rule id="103015" level="15">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_LSASS_Minidump</field>
    <description>ARGOS: YARA-15 - LSASS minidump detectado en $(yara_file) - ESC21/ESC22 T1003.001</description>
    <mitre>
      <id>T1003.001</id>
    </mitre>
    <group>argos_yara,credential_access</group>
  </rule>

  <!-- YARA-16: LOLBAS certutil con URL (ESC23 - T1105/T1218) -->
  <rule id="103016" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_LOLBAS_Certutil_URL</field>
    <description>ARGOS: YARA-16 - LOLBAS certutil con URL detectado en $(yara_file) - ESC23 T1105/T1218</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>argos_yara,defense_evasion</group>
  </rule>

  <!-- YARA-17: LOLBAS mshta/wscript/cscript con URL (ESC23 - T1218) -->
  <rule id="103017" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_LOLBAS_Script_URL</field>
