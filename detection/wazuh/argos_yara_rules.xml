<!-- ARGOS SOC - Miguel Reguero -->
<!-- Reglas YARA: detección basada en contenido de archivos -->
<!-- Rango: 103000-103009 (Linux) -->

<group name="argos,yara,linux">

  <rule id="103000" level="10">
    <decoded_as>argos_yara</decoded_as>
    <description>ARGOS: YARA match detectado en endpoint ARGOS - $(yara_rule) en $(yara_file)</description>
    <mitre>
      <id>T1059</id>
    </mitre>
    <group>argos_yara</group>
  </rule>

  <rule id="103001" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Bash_Reverse_Shell_Script</field>
    <description>ARGOS: YARA-01 - Bash reverse shell script detectado en $(yara_file) - ESC05 T1059.004</description>
    <mitre>
      <id>T1059.004</id>
    </mitre>
    <group>argos_yara,reverse_shell</group>
  </rule>

  <rule id="103002" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Bash_Crontab_Persistence</field>
    <description>ARGOS: YARA-02 - Persistencia via crontab detectada en $(yara_file) - ESC06 T1053.003</description>
    <mitre>
      <id>T1053.003</id>
    </mitre>
    <group>argos_yara,persistence</group>
  </rule>

  <rule id="103003" level="12">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Ingress_Tool_Transfer_Linux</field>
    <description>ARGOS: YARA-03 - Herramienta descargada detectada en $(yara_file) - ESC10 T1105</description>
    <mitre>
      <id>T1105</id>
    </mitre>
    <group>argos_yara,lateral_movement</group>
  </rule>

  <!-- YARA-04: Reverse shell en lenguajes interpretados Python/Perl (T1059.006/T1059.003) -->
  <rule id="103004" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Reverse_Shell_Interpreted_Languages</field>
    <description>ARGOS: YARA-04 - Reverse shell en script Python/Perl detectado en $(yara_file) - T1059.006/T1059.003</description>
    <mitre>
      <id>T1059.006</id>
    </mitre>
    <group>argos_yara,reverse_shell</group>
  </rule>

  <!-- YARA-05: Webshell PHP y Python en endpoint Linux (T1505.003) -->
  <rule id="103005" level="14">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Webshell_Linux</field>
    <description>ARGOS: YARA-05 - Webshell detectada en $(yara_file) - T1505.003 Server Software Component</description>
    <mitre>
      <id>T1505.003</id>
    </mitre>
    <group>argos_yara,webshell</group>
  </rule>

  <!-- YARA-06: PowerShell reverse shell TCPClient (ESC15 - T1059.001) -->
  <rule id="103006" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_PowerShell_Reverse_Shell</field>
    <description>ARGOS: YARA-06 - PowerShell reverse shell TCPClient detectado en $(yara_file) - ESC15 T1059.001</description>
    <mitre>
      <id>T1059.001</id>
    </mitre>
    <group>argos_yara,reverse_shell</group>
  </rule>

  <!-- YARA-07: PowerShell schtasks persistencia (ESC16 - T1053.005) -->
  <rule id="103007" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_PowerShell_Schtasks_Persistence</field>
    <description>ARGOS: YARA-07 - Script schtasks persistencia detectado en $(yara_file) - ESC16 T1053.005</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>argos_yara,persistence</group>
  </rule>

  <!-- YARA-08: Herramienta ofensiva depositada via SMB (ESC17/ESC18 - T1570) -->
  <rule id="103008" level="14">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_SMB_Lateral_Movement_Tool</field>
    <description>ARGOS: YARA-08 - Herramienta de movimiento lateral detectada en $(yara_file) - ESC17/ESC18 T1570</description>
    <mitre>
      <id>T1570</id>
    </mitre>
    <group>argos_yara,lateral_movement</group>
  </rule>

  <!-- YARA-09: Script desactivacion herramientas de seguridad (ESC19 - T1562.001) -->
  <rule id="103009" level="14">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_PowerShell_Disable_Security_Tools</field>
    <description>ARGOS: YARA-09 - Script desactivacion herramientas de seguridad detectado en $(yara_file) - ESC19 T1562.001</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>argos_yara,defense_evasion</group>
  </rule>

  <!-- YARA-10: Archivo Base64 generado por certutil -encode (ESC20 - T1041) -->
  <rule id="103010" level="12">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Certutil_Base64_Encoded_File</field>
    <description>ARGOS: YARA-10 - Archivo Base64 certutil detectado en $(yara_file) - ESC20 T1041</description>
    <mitre>
      <id>T1041</id>
    </mitre>
    <group>argos_yara,exfiltration</group>
  </rule>

  <!-- YARA-11: Script PowerShell FromBase64String decoder (T1027) -->
  <rule id="103011" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_PowerShell_Base64_Decoder</field>
    <description>ARGOS: YARA-11 - Script PowerShell decodificacion Base64 a disco detectado en $(yara_file) - T1027</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>argos_yara,defense_evasion</group>
  </rule>

  <!-- YARA-12: Script batch certutil -decode (T1027) -->
  <rule id="103012" level="13">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Certutil_Base64_Decode_Script</field>
    <description>ARGOS: YARA-12 - Script certutil -decode detectado en $(yara_file) - T1027</description>
    <mitre>
      <id>T1027</id>
    </mitre>
    <group>argos_yara,defense_evasion</group>
  </rule>

  <!-- YARA-13: Comandos mimikatz en scripts (ESC21/ESC22 - T1003.001) -->
  <rule id="103013" level="14">
    <if_sid>103000</if_sid>
    <field name="yara_rule">ARGOS_Mimikatz_Commands_Script</field>
