[Unit]
Description=ARGOS SOC - PB04 Exfiltracion de datos Integration
After=wazuh-manager.service
Requires=wazuh-manager.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 /var/ossec/integrations/argos_pb04_integration.py
Restart=always
RestartSec=5
StandardOutput=append:/var/ossec/logs/argos_pb04_integration.log
StandardError=append:/var/ossec/logs/argos_pb04_integration.log

[Install]
WantedBy=multi-user.target
